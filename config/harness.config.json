{
  "identity": {
    "actorId": "operator-local",
    "workspaceId": "synthetic-default"
  },
  "provider": {
    "kind": "ollama",
    "baseUrl": "http://127.0.0.1:11434",
    "model": "REPLACE_WITH_YOUR_MODEL",
    "timeoutMs": 30000,
    "numCtx": 8192,
    "keepAlive": "5m",
    "seed": 7,
    "temperature": 0,
    "allowNonLocalProvider": false
  },
  "policy": {
    "riskAllowlist": ["READ", "DRAFT", "MUTATION", "FINANCIAL"],
    "requireConfirmationFor": ["FINANCIAL"],
    "grantedPermissions": ["accounting.read", "accounting.write", "accounting.financial"]
  },
  "confirmation": { "ttlSeconds": 120 },
  "authority": { "permitTtlSeconds": 60 },
  "exposure": {
    "maxCapabilities": 12,
    "domains": ["accounting.customers", "accounting.invoices", "accounting.ledger"]
  },
  "adapters": {
    "mock": { "enabled": true },
    "http": {
      "enabled": false,
      "baseUrl": "",
      "bindings": {},
      "headersFile": null,
      "timeoutMs": 10000
    }
  },
  "evidence": { "dir": "var/evidence" }
}
